            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Date]",
            "lineageTag": "6b138773-3fd4-5085-9941-c9fdf0d9181d",
            "summarizeBy": "none",
            "formatString": "Long Date",
            "isKey": true
          },
          {

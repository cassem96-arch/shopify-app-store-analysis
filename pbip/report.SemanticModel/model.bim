            "isDataTypeInferred": true,
            "sourceColumn": "[Quarter]",
            "lineageTag": "6f07f0ad-9e57-5e85-a185-e0586be6e94b",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Number",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month Number]",
            "lineageTag": "f2020550-d304-5e19-8017-6c2a1a7fe47d",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Name",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month Name]",
            "lineageTag": "f141ca1f-4eaa-581c-9fc0-0c0896d59a86",
            "summarizeBy": "none",
            "sortByColumn": "Month Number"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year-Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year-Month]",
            "lineageTag": "f10e3336-caeb-5ea8-94b0-e63f213d03f1",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Start",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month Start]",
            "lineageTag": "4b0c3278-e9d7-552e-8c18-acc3cde93c0a",
            "summarizeBy": "none",
            "formatString": "mmm yyyy"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS (",
                "    CALENDAR (",
                "        DATE ( YEAR ( MIN ( reviews[posted_at] ) ), 1, 1 ),",
                "        DATE ( YEAR ( MAX ( reviews[posted_at] ) ), 12, 31 )",
                "    ),",
                "    \"Year\", YEAR ( [Date] ),",
                "    \"Quarter\", \"Q\" & QUARTER ( [Date] ),",
                "    \"Month Number\", MONTH ( [Date] ),",
                "    \"Month Name\", FORMAT ( [Date], \"MMM\" ),",
                "    \"Year-Month\", FORMAT ( [Date], \"YYYY-MM\" ),",
                "    \"Month Start\", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )",
                ")"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "9133049e-5cd7-5fca-a097-48b9b3e4395c",
        "fromTable": "reviews",
        "fromColumn": "app_id",
        "toTable": "apps",
        "toColumn": "app_id"
      },
      {
        "name": "744e966d-3563-5412-96b8-873c5d5471cd",
        "fromTable": "reviews",
        "fromColumn": "posted_at",
        "toTable": "dim_date",
        "toColumn": "Date"
      }
    ],
    "expressions": [

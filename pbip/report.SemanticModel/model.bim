          {
            "name": "monthly_price_usd",
            "dataType": "double",
            "sourceColumn": "monthly_price_usd",
            "lineageTag": "d1414349-6c0e-55fc-8120-3646b223cf7b",
            "summarizeBy": "sum",
            "formatString": "\\$#,0.00",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "apps",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"apps.csv\"), [Delimiter = \",\", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Promoted Headers\", {{\"app_name\", Text.Trim, type text}, {\"developer\", Text.Trim, type text}}),",
                "    #\"Blank Developer To Null\" = Table.ReplaceValue(#\"Trimmed Text\", \"\", null, Replacer.ReplaceValue, {\"developer\"}),",
                "    #\"Replaced Null Developer\" = Table.ReplaceValue(#\"Blank Developer To Null\", null, \"Unknown Developer\", Replacer.ReplaceValue, {\"developer\"}),",
                "    #\"Capitalized Each Word\" = Table.TransformColumns(#\"Replaced Null Developer\", {{\"category_name\", Text.Proper, type text}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Capitalized Each Word\", {{\"app_id\", Int64.Type}, {\"app_name\", type text}, {\"developer\", type text}, {\"category_name\", type text}, {\"launch_date\", type date}, {\"has_free_plan\", type text}, {\"monthly_price_usd\", type number}}, \"en-US\")",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Apps",
            "expression": "COUNTROWS ( apps )",
            "formatString": "#,0",
            "lineageTag": "109bb594-5991-5d24-9989-6ae43e8d14ba",
            "displayFolder": "KPIs",
            "description": "Number of apps in the marketplace (one row per app)."
          },
          {
            "name": "Free Plan Apps %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( apps ), apps[has_free_plan] = \"Yes\" ), COUNTROWS ( apps ) )",
            "formatString": "0.0%",
            "lineageTag": "3b2538cd-85d3-53bd-bf69-accf1f037f5c",
            "displayFolder": "KPIs",
            "description": "Share of apps that offer a free plan."
          },
          {
            "name": "Avg Monthly Price (Paid)",
            "expression": "AVERAGE ( apps[monthly_price_usd] )",
            "formatString": "\\$#,0.00",
            "lineageTag": "53a1ed05-2167-5ed4-8396-0bc5ee54d7ae",
            "displayFolder": "KPIs",
            "description": "Average monthly price of apps that list a price (free-plan apps have no price)."
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {

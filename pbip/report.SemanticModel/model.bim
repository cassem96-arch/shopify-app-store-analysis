        "lineageTag": "0a69eb33-997d-51e5-b45f-43fb8f4410c1",
        "expression": "\"C:\\shopify-app-store-analysis\\data\\\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]",
        "description": "Folder that contains apps.csv and reviews.csv (end with a backslash).",
        "annotations": [

              }
            ]
          },
          {
            "name": "helpful_count",
            "dataType": "int64",
            "sourceColumn": "helpful_count",
            "lineageTag": "b06d4c24-0cc3-54f5-8d57-b4e225f0f7da",
            "summarizeBy": "sum",
            "formatString": "0",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "reviews",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"reviews.csv\"), [Delimiter = \",\", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"review_id\", Int64.Type}, {\"app_id\", Int64.Type}, {\"rating\", Int64.Type}, {\"posted_at\", type text}, {\"has_developer_reply\", type text}, {\"helpful_count\", Int64.Type}}),",
                "    #\"Removed Duplicates\" = Table.Distinct(Table.Buffer(#\"Changed Type\"), {\"review_id\"}),",
                "    #\"Kept Valid Ratings\" = Table.SelectRows(#\"Removed Duplicates\", each [rating] >= 1 and [rating] <= 5),",
                "    #\"Changed Type with Locale\" = Table.TransformColumnTypes(#\"Kept Valid Ratings\", {{\"posted_at\", type date}}, \"en-US\"),",
                "    #\"Replaced Yes\" = Table.ReplaceValue(#\"Changed Type with Locale\", \"Yes\", \"1\", Replacer.ReplaceValue, {\"has_developer_reply\"}),",
                "    #\"Replaced No\" = Table.ReplaceValue(#\"Replaced Yes\", \"No\", \"0\", Replacer.ReplaceValue, {\"has_developer_reply\"}),",
                "    #\"Changed Reply Type\" = Table.TransformColumnTypes(#\"Replaced No\", {{\"has_developer_reply\", Int64.Type}})",
                "in",
                "    #\"Changed Reply Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Reviews",
            "expression": "COUNTROWS ( reviews )",
            "formatString": "#,0",
            "lineageTag": "f6ef6953-7f2c-5728-ac60-44da413930ac",
            "displayFolder": "KPIs",
            "description": "Number of valid, de-duplicated reviews."
          },
          {
            "name": "Average Rating",
            "expression": "AVERAGE ( reviews[rating] )",
            "formatString": "0.00",
            "lineageTag": "9df76e70-ac28-5fbc-a1a3-d0b29b81e121",
            "displayFolder": "KPIs",
            "description": "Average star rating (1-5)."
          },
          {
            "name": "Developer Reply %",
            "expression": "DIVIDE ( SUM ( reviews[has_developer_reply] ), [Total Reviews] )",
            "formatString": "0.0%",
            "lineageTag": "ea53960b-962f-5835-8e2f-33e028ab7159",
            "displayFolder": "KPIs",
            "description": "Share of reviews that received a developer reply."
          },
          {
            "name": "Low Rating %",
            "expression": "DIVIDE ( CALCULATE ( [Total Reviews], reviews[rating] <= 2 ), [Total Reviews] )",
            "formatString": "0.0%",
            "lineageTag": "3553716b-b615-5712-ab6e-62b60ce5638c",
            "displayFolder": "KPIs",
            "description": "Share of 1-2 star reviews."
          },
          {
            "name": "Reviews PY",
            "expression": "CALCULATE ( [Total Reviews], SAMEPERIODLASTYEAR ( dim_date[Date] ) )",
            "formatString": "#,0",
            "lineageTag": "e155a583-828d-57b4-ac17-258fd3e27eb6",
            "displayFolder": "Time Intelligence",
            "description": "Reviews in the same period of the previous year."
          },
          {
            "name": "YoY %",
            "expression": "DIVIDE ( [Total Reviews] - [Reviews PY], [Reviews PY] )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "51c2eb52-5fb6-578a-b2cb-1e614fee1f14",
            "displayFolder": "Time Intelligence",
            "description": "Year-over-year growth in reviews."
          },
          {
            "name": "Reviews Prev Month",
            "expression": "CALCULATE ( [Total Reviews], DATEADD ( dim_date[Date], -1, MONTH ) )",
            "formatString": "#,0",
            "lineageTag": "a02ab05b-f7b5-5b94-8058-2af99d47e249",
            "displayFolder": "Time Intelligence",
            "description": "Reviews in the previous month (period shifted back one month)."
          },
          {
            "name": "MoM %",
            "expression": "DIVIDE ( [Total Reviews] - [Reviews Prev Month], [Reviews Prev Month] )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "7090e63e-5099-5ac9-9d85-b773bf4e0d11",
            "displayFolder": "Time Intelligence",
            "description": "Month-over-month growth in reviews."
          },
          {
            "name": "Reviews YTD",
            "expression": "TOTALYTD ( [Total Reviews], dim_date[Date] )",
            "formatString": "#,0",
            "lineageTag": "9df93eac-4c04-518f-9a44-77f03a4bc976",
            "displayFolder": "Time Intelligence",
            "description": "Running total of reviews from 1 January to the last date in context."
          },
          {
            "name": "Reviews MTD",
            "expression": "TOTALMTD ( [Total Reviews], dim_date[Date] )",
            "formatString": "#,0",
            "lineageTag": "1608c7b8-d0a6-51f5-8b67-0fbd492a83d6",
            "displayFolder": "Time Intelligence",
            "description": "Running total of reviews from the 1st of the month to the last date in context."
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dim_date",
        "lineageTag": "8dc37906-bdd0-5c69-a9e7-4fae611dee86",
        "dataCategory": "Time",
        "columns": [
